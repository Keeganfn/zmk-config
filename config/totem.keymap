#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                  &kp Q         &kp W  &kp E           &kp R             &kp T        &kp Y        &kp U              &kp I        &kp O    &kp P
                  &kp A         &kp S  &kp D           &hm LEFT_SHIFT F  &kp G        &kp H        &hm RIGHT_SHIFT J  &kp K        &kp L    &kp SEMICOLON
&mt LCTRL ESCAPE  &mt DELETE Z  &kp X  &kp C           &kp V             &kp B        &kp N        &kp M              &kp COMMA    &kp DOT  &mt RIGHT_ALT SLASH  &mt RIGHT_GUI APOS
                                       &kp LEFT_SHIFT  &lt 1 SPACE       &lt 3 TAB    &lt 3 SPACE  &lt 1 BACKSPACE    &lt 4 UNDER
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
              &kp TILDE       &trans     &trans  &kp UNDER  &kp LBRC    &kp RBRC  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
              &kp LEFT_SHIFT  &trans     &trans  &kp EQUAL  &kp LBKT    &kp RBKT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PERIOD
&kp LEFT_ALT  &kp LEFT_WIN    &kp MINUS  &trans  &kp PLUS   &kp LPAR    &kp RPAR  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MULTIPLY  &kp PLUS
                                         &trans  &trans     &trans      &trans    &trans        &kp MINUS
            >;
        };

        layer_4 {
            bindings = <
           &kp N1  &kp N2  &kp N3  &kp N4       &kp N5    &kp N6     &kp N7        &kp N8        &kp N9          &kp N0
           &trans  &trans  &trans  &kp LS(DQT)  &trans    &kp EQUAL  &kp LBKT      &kp RBKT      &kp UNDERSCORE  &kp LS(COLON)
&kp GRAVE  &trans  &trans  &trans  &trans       &trans    &trans     &kp LS(LPAR)  &kp LS(RPAR)  &kp DOT         &trans         &trans
                           &trans  &trans       &trans    &trans     &trans        &trans
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
                &kp K_REDO      &kp K_CUT   &kp K_COPY  &kp K_PASTE   &kp K_UNDO      &kp K_UNDO      &kp K_PASTE     &kp K_COPY    &kp BACKSPACE    &kp K_REDO
                &kp LEFT_SHIFT  &kp ESCAPE  &kp LCTRL   &kp LEFT_ALT  &kp LEFT_GUI    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&studio_unlock  &trans          &trans      &trans      &trans        &trans          &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans      &kp DEL
                                            &trans      &trans        &trans          &kp SPACE       &kp ENTER       &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &bootloader  &trans  &trans  &trans  &trans    &trans  &kp F7  &kp F8  &kp F9  &kp F10
        &trans       &trans  &trans  &trans  &trans    &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans       &trans  &trans  &trans  &trans    &trans  &kp F1  &kp F2  &kp F3  &kp F12  &trans
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
              &kp LS(PLUS)  &kp N7  &kp N8  &kp N9      &kp N0       &kp LS(PLUS)  &kp LS(STAR)  &trans  &kp BSPC  &trans
              &kp MINUS     &kp N4  &kp N5  &kp N6      &kp DOT      &kp EQUAL     &kp DOT       &trans  &trans    &kp LSHFT
&kp LS(STAR)  &kp FSLH      &kp N1  &kp N2  &kp N3      &kp EQUAL    &kp MINUS     &kp FSLH      &trans  &trans    &trans     &trans
                                    &trans  &kp RETURN  &kp SPACE    &trans        &trans        &trans
            >;
        };

        layer_6 {
            bindings = <
        &trans     &kp EXCLAMATION  &kp N0    &kp N1        &kp MINUS    &kp EQUAL     &kp LS(DQT)   &kp LS(UNDER)  &kp BSPC      &trans
        &kp LSHFT  &kp LS(LBRC)     &kp LBKT  &kp LS(LPAR)  &kp BSLH     &kp LS(PLUS)  &kp LS(LPAR)  &kp RBKT       &kp LS(RBRC)  &mt LSHFT COLON
&trans  &trans     &trans           &trans    &trans        &trans       &kp MINUS     &kp LBKT      &kp RBKT       &kp DOT       &trans           &trans
                                    &trans    &trans        &trans       &kp SPACE     &kp ENTER     &trans
            >;
        };
    };
};
