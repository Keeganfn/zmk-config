#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                  &kp Q         &kp W  &kp E           &kp R             &kp T          &kp Y            &kp U              &kp I        &kp O    &kp P
                  &kp A         &kp S  &kp D           &hm F LEFT_SHIFT  &kp G          &kp H            &hm J RIGHT_SHIFT  &kp K        &kp L    &kp SEMICOLON
&mt LCTRL ESCAPE  &mt DELETE Z  &kp X  &kp C           &kp V             &kp B          &kp N            &kp M              &kp COMMA    &kp DOT  &mt RIGHT_ALT SLASH  &mt RIGHT_GUI APOS
                                       &kp LEFT_SHIFT  &lt 1 TAB         &lt 2 SPACE    &lt 2 BACKSPACE  &lt 1 ENTER        &lt 3 UNDER
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
              &kp TILDE       &trans     &trans  &kp UNDER  &kp LBRC    &kp RBRC  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
              &kp LEFT_SHIFT  &trans     &trans  &kp EQUAL  &kp LBKT    &kp RBKT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PERIOD
&kp LEFT_ALT  &kp LEFT_WIN    &kp MINUS  &trans  &kp PLUS   &kp LPAR    &kp RPAR  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MULTIPLY  &kp PLUS
                                         &trans  &trans     &trans      &trans    &trans        &kp MINUS
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
                &kp EXCL  &kp AT      &kp HASH   &kp DOLLAR    &kp PERCENT     &kp CARET       &kp AMPERSAND   &kp KP_ASTERISK  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE
                &trans    &kp ESCAPE  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT_ARROW    &trans
&studio_unlock  &trans    &trans      &trans     &trans        &trans          &kp EQUAL       &kp UNDER       &kp PAGE_UP      &kp PAGE_DOWN      &kp SLASH         &kp HOME
                                      &trans     &trans        &trans          &trans          &trans          &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &bootloader  &trans  &trans  &trans  &trans    &trans  &kp F7  &kp F8  &kp F9  &kp F10
        &trans       &trans  &trans  &trans  &trans    &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans       &trans  &trans  &trans  &trans    &trans  &kp F1  &kp F2  &kp F3  &kp F12  &trans
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
